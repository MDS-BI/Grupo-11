%% MER — Módulo de Logística e Inventario (Grupo 11)
%% Leyenda:
%%   (objetivo) = tabla del modelo de dominio completo que NO se implementa en la v1.
%%   inventory_stock es una PROYECCIÓN derivada de inventory_transactions menos reservas activas;
%%   no se edita a mano. El saldo siempre se calcula sumando movimientos.
%%   Los movimientos de traslado usan transfer_id + transfer_leg ('origen' | 'destino').

erDiagram
    companies {
        int company_id PK
    }
    addresses {
        int address_id PK
    }
    employees {
        int employee_id PK
    }
    purchase_orders {
        int purchase_order_id PK
        varchar folio
        varchar status
        date order_date
    }
    sales_orders {
        int sales_order_id PK
        varchar folio
        varchar status
        date order_date
    }
    product_categories {
        int product_category_id PK
        int parent_category_id FK
        varchar category_name
    }
    units_of_measure {
        int uom_id PK
        varchar uom_name
        varchar uom_symbol
    }
    products {
        int product_id PK
        int product_category_id FK
        int uom_id FK
        varchar sku
        varchar product_name
        varchar product_type
        int min_stock
        decimal standard_cost
        boolean is_active
    }
    warehouses {
        int warehouse_id PK
        int company_id FK
        int address_id FK
        varchar warehouse_code
        varchar warehouse_name
        boolean is_active
    }
    warehouse_locations {
        int location_id PK
        int warehouse_id FK
        varchar location_code
        varchar aisle
        varchar rack
        varchar bin
    }
    product_lots {
        int lot_id PK
        int product_id FK
        varchar lot_number
        date manufactured_at
        date expires_at
    }
    inventory_stock {
        int stock_id PK
        int product_id FK
        int warehouse_id FK
        int location_id FK
        decimal quantity_on_hand
        decimal quantity_reserved
    }
    inventory_transactions {
        int inventory_transaction_id PK
        int product_id FK
        int warehouse_id FK
        int location_id FK
        int lot_id FK
        varchar transaction_type
        decimal quantity
        decimal unit_cost
        varchar reason
        varchar status
        datetime status_changed_at
        int created_by FK
        datetime transaction_date
        int purchase_order_id FK
        int shipment_id FK
        int transfer_id FK
        varchar transfer_leg
        int count_id FK
        int reservation_id FK
        int return_id FK
    }
    stock_reservations {
        int reservation_id PK
        int product_id FK
        int warehouse_id FK
        decimal quantity
        decimal released_quantity
        varchar reference
        varchar status
        date expires_at
        int movement_id FK
        datetime created_at
        datetime updated_at
    }
    stock_transfers {
        int transfer_id PK
        int from_warehouse_id FK
        int to_warehouse_id FK
        date transfer_date
        varchar status
        int created_by FK
        datetime created_at
        datetime dispatched_at
        datetime received_at
    }
    stock_transfer_lines {
        int transfer_line_id PK
        int transfer_id FK
        int product_id FK
        int lot_id FK
        decimal quantity
    }
    stock_counts {
        int count_id PK
        varchar reference
        int warehouse_id FK
        varchar status
        varchar notes
        date started_at
        date confirmed_at
        int created_by FK
    }
    stock_count_lines {
        int count_line_id PK
        int count_id FK
        int product_id FK
        int lot_id FK
        decimal system_quantity
        decimal counted_quantity
        int adjustment_transaction_id FK
    }
    stock_returns {
        int return_id PK
        varchar return_kind
        int movement_id FK
        int transfer_id FK
        int product_id FK
        int warehouse_id FK
        varchar reason
        decimal quantity_good
        decimal quantity_damaged
        varchar status
        datetime created_at
    }
    goods_receipts {
        int goods_receipt_id PK
        int purchase_order_id FK
        int warehouse_id FK
        date receipt_date
        varchar status
    }
    goods_receipt_lines {
        int goods_receipt_line_id PK
        int goods_receipt_id FK
        int product_id FK
        int lot_id FK
        decimal quantity_received
    }
    carriers {
        int carrier_id PK
        varchar carrier_name
        varchar contact_info
    }
    shipments {
        int shipment_id PK
        int sales_order_id FK
        int warehouse_id FK
        int carrier_id FK
        date ship_date
        varchar tracking_number
        varchar status
    }
    shipment_lines {
        int shipment_line_id PK
        int shipment_id FK
        int product_id FK
        decimal quantity_shipped
    }

